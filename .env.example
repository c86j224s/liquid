LIQUID_HOST=127.0.0.1
LIQUID_PORT=3000
LIQUID_DATA_DIR=./data
LIQUID_AI_WORKERS=1
LIQUID_LOCAL_AI_WORKERS=1
LIQUID_AI_TASK_TIMEOUT_SECS=3600
LIQUID_CLI_LAUNCH_MODE=auto

# Set LIQUID_HOST=0.0.0.0 only when you intentionally want LAN or server access.

# Optional: local HTML research design skill path
# LIQUID_RESEARCH_HTML_SKILL_PATH=/path/to/your/SKILL.md

# Optional: provider configuration for live research discovery
# LIQUID_RESEARCH_SEARCH_PROVIDERS=duckduckgo
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_REST_API_KEY=
# BRAVE_SEARCH_API_KEY=
